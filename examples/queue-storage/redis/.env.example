# Copy to .env and adjust as needed.
# REDIS_URL takes precedence over REDIS_HOST/PORT/PASSWORD/DB if set.

REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Optional: namespace all keys (default "a2a:"). Useful when multiple ADK
# deployments share a single Redis instance.
# REDIS_KEY_PREFIX=a2a:

# Optional: override the agent card fields.
# A2A_AGENT_NAME=queue-storage-redis-agent
# A2A_AGENT_DESCRIPTION=A2A echo agent backed by RedisTaskStorage.
# A2A_AGENT_VERSION=0.0.0

# Optional: HTTP listen host/port.
# A2A_SERVER_HOST=127.0.0.1
# A2A_SERVER_PORT=8080
