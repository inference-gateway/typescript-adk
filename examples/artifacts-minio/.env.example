# MinIO endpoint, region, credentials, and bucket. Defaults match the bundled
# docker-compose.yml so the example works out of the box against `minio:up`.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=artifacts

# URL emission mode: "direct" (default) returns a short-lived presigned GET
# URL; "proxy" returns a stable URL backed by the ADK server's /artifacts
# endpoint, which streams bytes through the storage provider on demand.
ARTIFACTS_MODE=direct

# When ARTIFACTS_MODE=proxy, the base URL emitted in FilePart.fileWithUri.
# Defaults to http://${A2A_SERVER_HOST}:${A2A_SERVER_PORT}/artifacts.
# ARTIFACTS_BASE_URL=http://127.0.0.1:8080/artifacts

# Optional: lifetime in seconds for presigned URLs in "direct" mode.
# Defaults to 300 (5 minutes).
# ARTIFACTS_PRESIGN_EXPIRY=300

# Optional agent-card overrides.
# A2A_AGENT_NAME=artifacts-minio-agent
# A2A_AGENT_DESCRIPTION=A2A agent that persists each request as an object in a MinIO bucket.
# A2A_AGENT_VERSION=0.0.0

# Server bind.
# A2A_SERVER_HOST=127.0.0.1
# A2A_SERVER_PORT=8080
