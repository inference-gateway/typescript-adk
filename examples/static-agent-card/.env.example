# Copy to `.env` and tweak before running the server:
#   cp examples/static-agent-card/.env.example examples/static-agent-card/.env
#   set -a; source examples/static-agent-card/.env; set +a

# Values consumed by ${VAR} placeholders in agent-card.json.
# All five are required — loadAgentCardFromFile() throws if any are missing.
A2A_AGENT_NAME=static-card-agent
A2A_AGENT_DESCRIPTION="A demonstration agent that loads its configuration from a static JSON file"
A2A_AGENT_VERSION=0.1.0
A2A_SERVER_HOST=127.0.0.1
A2A_SERVER_PORT=8080

# Optional: point the server at a different card file.
# A2A_AGENT_CARD_FILE=./my-custom-card.json

# Optional client-side overrides.
# SERVER_URL=http://127.0.0.1:8080
# PROMPT="Hello! Tell me about your static configuration."
