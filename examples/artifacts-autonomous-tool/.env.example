# Inference Gateway provider API keys.
# Set the one matching A2A_AGENT_CLIENT_PROVIDER below, or set
# A2A_AGENT_CLIENT_API_KEY directly to bypass the per-provider lookup.
ANTHROPIC_API_KEY=
CLOUDFLARE_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OLLAMA_API_KEY=
OLLAMA_CLOUD_API_KEY=
OPENAI_API_KEY=

# Agent / LLM configuration.
A2A_AGENT_CLIENT_PROVIDER=openai
A2A_AGENT_CLIENT_MODEL=gpt-4o-mini
# Optional: point at the Inference Gateway, Ollama, or any other
# OpenAI-compatible endpoint. Defaults to the SDK's localhost gateway.
# A2A_AGENT_CLIENT_BASE_URL=http://localhost:8080/v1
# Optional: explicit API key. Falls back to <PROVIDER>_API_KEY.
# A2A_AGENT_CLIENT_API_KEY=

# Root directory for the on-disk artifact store. Defaults to
# <os.tmpdir>/adk-artifacts-autonomous.
# ARTIFACTS_ROOT=/tmp/adk-artifacts-autonomous

# Base URL emitted in FilePart.fileWithUri. Defaults to
# http://${A2A_SERVER_HOST}:${A2A_SERVER_PORT}/artifacts.
# ARTIFACTS_BASE_URL=

# Optional agent-card overrides.
# A2A_AGENT_NAME=artifacts-autonomous-tool-agent
# A2A_AGENT_DESCRIPTION=An LLM-backed A2A agent that uses the reserved create_artifact tool to surface generated content.
# A2A_AGENT_VERSION=0.0.0
# A2A_AGENT_SYSTEM_PROMPT=You are a helpful assistant. When asked to produce a document or report, ALWAYS call the create_artifact tool with the content rather than inlining it into your reply.

# Server bind.
# A2A_SERVER_HOST=127.0.0.1
# A2A_SERVER_PORT=8080
