# Inference Gateway provider API keys.
# Set the one matching A2A_AGENT_CLIENT_PROVIDER below, or set
# A2A_AGENT_CLIENT_API_KEY directly to bypass the per-provider lookup.
ANTHROPIC_API_KEY=
CLOUDFLARE_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
OLLAMA_API_KEY=
OLLAMA_CLOUD_API_KEY=
OPENAI_API_KEY=

# Agent / LLM configuration.
A2A_AGENT_CLIENT_PROVIDER=openai
A2A_AGENT_CLIENT_MODEL=gpt-4o-mini
# Nvidia NIM (build.nvidia.com API catalog): set the two lines above to
#   A2A_AGENT_CLIENT_PROVIDER=nvidia
#   A2A_AGENT_CLIENT_MODEL=nvidia/meta/llama-3.1-8b-instruct
# and provide NVIDIA_API_KEY (the leading `nvidia/` model prefix is stripped).
# Optional: point at the Inference Gateway, Ollama (http://localhost:11434/v1),
# or any other OpenAI-compatible endpoint. Defaults to the SDK's localhost gateway.
# A2A_AGENT_CLIENT_BASE_URL=http://localhost:8080/v1
# Optional: explicit API key. Falls back to <PROVIDER>_API_KEY (e.g. OPENAI_API_KEY).
# A2A_AGENT_CLIENT_API_KEY=

# Optional agent-card overrides.
# A2A_AGENT_NAME=ai-streaming-agent
# A2A_AGENT_DESCRIPTION=An LLM-backed A2A agent that streams responses with weather and time tools.
# A2A_AGENT_VERSION=0.0.0
# A2A_AGENT_SYSTEM_PROMPT=You are a helpful AI assistant with access to weather and time tools. Stream your thinking and respond conversationally.

# Server bind.
# A2A_SERVER_HOST=127.0.0.1
# A2A_SERVER_PORT=8080
